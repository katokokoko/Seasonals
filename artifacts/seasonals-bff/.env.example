# Seasonals BFF — Environment variables (template)
# Copy to `.env` and fill values. `.env` is gitignored.

# ── HTTP server ──
PORT=3030
HOST=0.0.0.0

# ── Solana ──
# Devnet を default。memo tx 生成 (approve endpoint) で使う。
SOLANA_RPC_URL=https://api.devnet.solana.com

# ── Helius DAS (Phase 8.1) ──
# mainnet wallet positions を取得する場合に必須。
# 取得: https://www.helius.dev/ → Sign up → Create API Key (Mainnet)
# 未設定でも /positions (no wallet query) は fixture を返すので "Seasonals" APK は動く。
# 設定すると /positions?wallet=<addr> で実 mainnet positions を返す ("Seasonals (onchain)" APK 用)。
HELIUS_API_KEY=

# Ethereum (docs/web/WORKLOG.md) — server-side only. 値は commit しない
INFURA_API_KEY=
# ETHEREUM_RPC_URL=            # 任意: INFURA_API_KEY より優先
ETHERSCAN_API_KEY=             # 評価額履歴の tx 差分 + CCA bid scan の logs (Etherscan API V2、free tier 可)。未設定なら bid scan は Infura getLogs (重い)
UNISWAP_API_KEY=
# ETH_EXECUTION_TARGET=fork    # fork | mainnet (mainnet は送信拒否、plan のみ)
# ETH_FORK_RPC_URL=http://127.0.0.1:8545
# FORK_UPSTREAM_RPC_URL=        # 任意: Anvil fork (scripts/eth-fork.sh) の上流 RPC。例: Alchemy free の key
#                               #   (fork の storage 取得を Infura の日次枠から外す)。未設定なら Infura を使う
# ANTHROPIC_API_KEY=           # 任意: 無ければ提案は rule-based

# ── SKR staking cooldown (docs/skr-r0-implementation.md、R0) ──
# live は HELIUS_API_KEY で mainnet を読む (未設定なら data_status=unavailable)。
# demo source (?source=demo) は録画 / 実機確認用。true の時だけ受け付ける (live の失敗を demo に差し替えない)
# SKR_DEMO_FIXTURE=true
# SKR_DEMO_SCENARIO=cooling_down       # cooling_down | ready | none | absent | unsupported
# SKR_DEMO_UNLOCK_IN_SECONDS=1800      # BFF 起動時刻から終了予定までの秒。値を変えて再起動 = 追加解除の再現

# ── Public deployment (docs/external-release-api-handling.md、Fly.io で api.seasonals.cafe) ──
# 全部未設定なら従来の dev 挙動。公開 BFF では以下を設定する (値は commit しない)。
# SOLANA_EXECUTION_TARGET=mainnet      # mainnet (既定) | disabled。disabled は /tx/submit・/protocols/*/*-tx・/agent-plans/:id/execute を
#                                      #   409 action_not_available で止める (simulate-only、Seed Vault が開く前に止まる)。他の値は disabled 扱い (fail-closed)
# CORS_ALLOWED_ORIGINS=https://seasonals.cafe   # カンマ区切り。未設定 = any origin (dev)。mobile は Origin を送らないので影響なし
# RATE_LIMIT_MAX=300                   # IP あたり /分 (@fastify/rate-limit)。0 で無効。/tx/submit は 10、Helius を叩く読み取りは 60 に個別制限。/health は対象外。
#                                      #   超過は 429 { error: "rate_limited" } + retry-after
# ADMIN_TOKEN=                         # PATCH /user-policy と POST /autonomous/kill|resume の header x-seasonals-admin-token。
#                                      #   未設定: dev は開放 / NODE_ENV=production では 403 (fail-closed)。kill|resume は FEATURE_APPROVAL_MODE_AUTO が off なら常に 403
# BFF_PROXY_SECRET=                    # Cloudflare Pages Function (web の /api/*) が付ける x-seasonals-proxy-key。一致した時だけ
#                                      #   x-seasonals-client-ip を rate limit の key に使う (不一致なら fly-client-ip → req.ip)
# EXPO_PUSH_ENABLED=true               # 未設定なら POST /push-tokens は 503 push_not_configured (FCM 未設定の v1 では push 承認は配送されない)
# GIT_SHA=                             # /health の version。Docker の build-arg で注入される
# SEASONALS_DATA_DIR=.data             # plan / approval token / policy の JSON 置き場。Fly では /data (volume)。production で書けないと起動しない
#
# ⚠ 公開 BFF では設定しない。NODE_ENV=production でこれらがあると起動ガード (src/flags.ts assertProductionEnvSafe) が exit 1 する:
# FEATURE_APPROVAL_MODE_AUTO=true      # 自律実行の feature flag (devnet 専用)
# AUTONOMOUS_DELEGATE_SECRET=          # BFF が keypair を持つ唯一の経路 (devnet 専用)
# AUTONOMOUS_LOOP_MS=0                 # 自律 scheduler (opt-in)
