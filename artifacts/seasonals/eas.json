{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "development"
      }
    },
    "onchain": {
      "extends": "development",
      "env": {
        "APP_ENV": "development",
        "APP_VARIANT": "onchain"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "production"
      }
    },
    "preview-onchain": {
      "extends": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      },
      "env": {
        "APP_ENV": "preview",
        "APP_VARIANT": "onchain",
        "BFF_BASE_URL": "https://api.seasonals.cafe"
      }
    },
    "production-onchain": {
      "extends": "production",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      },
      "env": {
        "APP_ENV": "production",
        "APP_VARIANT": "onchain",
        "BFF_BASE_URL": "https://api.seasonals.cafe"
      }
    }
  }
}
